{
  "buildCommand": "node scripts/sync-chain.js && node scripts/build.js",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/blitz", "destination": "/blitz.html" },
    { "source": "/sage", "destination": "/sage.html" },
    { "source": "/hype", "destination": "/hype.html" },
    { "source": "/hex", "destination": "/hex.html" },
    { "source": "/ghost", "destination": "/ghost.html" },
    { "source": "/trader/:name", "destination": "/:name.html" }
  ]
}
